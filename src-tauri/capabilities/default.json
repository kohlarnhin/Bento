{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Bento main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
